# Acceptance test settings for `make testacc-one`.
# Copy to .scalr-testenv.env (git-ignored), fill in, and `chmod 600 .scalr-testenv.env`.
# Use a disposable test environment with the fatmouse seed data, never production.

# Required. Hostname without https://, e.g. mainiacp.<testenv>.testenv.scalr.dev
SCALR_HOSTNAME=
SCALR_TOKEN=

# Optional. Tests that need these skip themselves when they are empty.
# TEST_AWS_ACCESS_KEY=
# TEST_AWS_SECRET_KEY=
# TEST_AWS_ROLE_ARN=
# TEST_AWS_EXTERNAL_ID=
# AWS_EVENT_BRIDGE_ACCOUNT_ID=
# AWS_EVENT_BRIDGE_REGION=
# TEST_ARM_CLIENT_ID=
# TEST_ARM_CLIENT_SECRET=
# TEST_ARM_TENANT_ID=
# TEST_ARM_SUBSCRIPTION_ID=
# TEST_GOOGLE_PROJECT=
# TEST_GOOGLE_CREDENTIALS=
# TEST_AZURE_DEVOPS_ORGANIZATION=
# TEST_AZURE_DEVOPS_TOKEN=
# TEST_DOCKER_REGISTRY_URL=
# TEST_DOCKER_REGISTRY_USERNAME=
# TEST_DOCKER_REGISTRY_PASSWORD=
# TEST_INFRACOST_API_KEY=
# githubToken=
